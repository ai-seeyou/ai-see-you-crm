# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files. `.env.example` is the one that is committed — it is the
# documentation, so the catch-all below must not swallow it.
.env
.env.*
!.env.example

# Testing. The pattern is unanchored, so it matches a directory called "coverage"
# at any depth. COVERAGE is a view in this product, so two directories of real
# source carry that name and both have to be excepted by hand. One of them was
# missed and the branch did not compile from a fresh clone. The brackets in
# [slug] are escaped because gitignore reads them as a character class, and an
# unescaped negation silently does nothing.
coverage
!apps/api/src/coverage
!apps/app/app/(app)/\[slug\]/coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
/.logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Agent worktrees
.claude/worktrees/

# Skills are installed to .agents/skills; .claude/skills mirrors them per-tool
.claude/skills/

# eve build output
.eve
.output
/dogfood-output

# Agent scratch files
.scratch/
